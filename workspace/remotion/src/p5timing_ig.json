{"lines": [{"id": "01", "start": 7, "end": 58, "text": "Lose sales with your AI email?", "words": [{"w": "Lose", "s": 7, "e": 14}, {"w": "sales", "s": 16, "e": 25}, {"w": "with", "s": 26, "e": 30}, {"w": "your", "s": 31, "e": 35}, {"w": "AI", "s": 38, "e": 46}, {"w": "email?", "s": 49, "e": 58}]}, {"id": "02", "start": 74, "end": 151, "text": "Customers still spot 2 AI signatures.", "words": [{"w": "Customers", "s": 74, "e": 88}, {"w": "still", "s": 92, "e": 98}, {"w": "spot", "s": 101, "e": 111}, {"w": "2", "s": 113, "e": 121}, {"w": "AI", "s": 125, "e": 132}, {"w": "signatures.", "s": 135, "e": 151}]}, {"id": "03", "start": 169, "end": 252, "text": "Same sale email, ChatGPT and Claude.", "words": [{"w": "Same", "s": 169, "e": 176}, {"w": "sale", "s": 179, "e": 186}, {"w": "email,", "s": 189, "e": 199}, {"w": "ChatGPT", "s": 209, "e": 233}, {"w": "and", "s": 236, "e": 239}, {"w": "Claude.", "s": 241, "e": 252}]}, {"id": "04", "start": 268, "end": 329, "text": "One shouts, one decorates.", "words": [{"w": "One", "s": 268, "e": 272}, {"w": "shouts,", "s": 276, "e": 289}, {"w": "one", "s": 302, "e": 307}, {"w": "decorates.", "s": 311, "e": 329}]}, {"id": "05", "start": 347, "end": 476, "text": "ChatGPT: 4 exclamation marks, a bold line, a long dash.", "words": [{"w": "ChatGPT:", "s": 347, "e": 371}, {"w": "4", "s": 382, "e": 387}, {"w": "exclamation", "s": 389, "e": 404}, {"w": "marks,", "s": 406, "e": 415}, {"w": "a", "s": 421, "e": 423}, {"w": "bold", "s": 425, "e": 433}, {"w": "line,", "s": 434, "e": 443}, {"w": "a", "s": 452, "e": 454}, {"w": "long", "s": 456, "e": 463}, {"w": "dash.", "s": 465, "e": 476}]}, {"id": "06", "start": 488, "end": 531, "text": "Then, \"Don't miss out.\"", "words": [{"w": "Then,", "s": 488, "e": 496}, {"w": "\"Don't", "s": 509, "e": 515}, {"w": "miss", "s": 516, "e": 521}, {"w": "out.\"", "s": 524, "e": 531}]}, {"id": "07", "start": 549, "end": 625, "text": "Claude: 3 emoji, and a list of 3.", "words": [{"w": "Claude:", "s": 549, "e": 56
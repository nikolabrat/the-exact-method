{
  "name": "exact-dm",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "kv_namespaces": [{ "binding": "BOT" }],
  "durable_objects": { "bindings": [{ "name": "STORE", "class_name": "Store" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store"] }],
  "triggers": { "crons": ["*/2 * * * *"] },
  "vars": {
    "META_APP_ID": "1400181691959713",
    "LOGIN_CONFIG_ID": "3178376512358834",
    "VERIFY_TOKEN": "exactmethod-dm-webhook",
    "EXPECTED_USERNAME": "theexactmethod"
  }
}
